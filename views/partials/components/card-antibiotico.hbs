<link rel="stylesheet" href="css/form.styles.css">
<div class="antibiotico-form antibiotico-seleccionado">
  <div class="antibiotico-header">
    <div class="antibiotico-title">
      <span class="antibiotico-tipo" data-field="tipo"></span>
      <h3 data-field="nombre"></h3>
    </div>

    <div class="antibiotico-check-mark">
      Seleccionado
    </div>
  </div>

  <div class="grid-layout">
    <div class="form-group col-6">
      <label>
        Cantidad
        <span class="req">*</span>
      </label>

      <input class="form-control campo-medicamento" type="number" data-name="cantidad" min="1" step="1" required>
    </div>

    <div class="form-group col-6">
      <label>
        Dosis
        <span class="req">*</span>
      </label>

      <input class="form-control campo-medicamento" type="number" data-name="dosis" min="0.01" step="0.01" required>
    </div>

    <div class="form-group col-6">
      <label>
        Unidad de dosis
        <span class="req">*</span>
      </label>
      <select class="form-control campo-medicamento" data-name="unidadDosis" required>
        <option value="">
          Seleccione
        </option>

        <option value="mg">
          mg
        </option>

        <option value="g">
          g
        </option>

        <option value="mcg">
          mcg
        </option>

        <option value="UI">
          UI
        </option>
      </select>
    </div>

    <div class="form-group col-6">
      <label>
        Vía de administración
        <span class="req">*</span>
      </label>

      <select class="form-control campo-medicamento" data-name="via" required>

        <option value="">
          Seleccione
        </option>

        <option value="Intravenosa">
          Intravenosa
        </option>

        <option value="Oral">
          Oral
        </option>

        <option value="Intramuscular">
          Intramuscular
        </option>

        <option value="Subcutánea">
          Subcutánea
        </option>

      </select>

    </div>
    <div class="form-group col-6 campo-destacado">
      <label>
        Frecuencia
        <span class="req">*</span>
      </label>

      <select class="form-control campo-medicamento select-destacado" data-name="frecuencia" required>

        <option value="">
          Seleccione la frecuencia
        </option>

        <option value="Cada 24 horas">
          Cada 24 horas
        </option>

        <option value="Cada 12 horas">
          Cada 12 horas
        </option>

        <option value="Cada 8 horas">
          Cada 8 horas
        </option>

        <option value="Cada 6 horas">
          Cada 6 horas
        </option>
        <option value="Dosis única / STAT">
          Dosis única / STAT
        </option>
      </select>
    </div>

    <div class="form-group col-6 campo-destacado">
      <label>
        Fecha de inicio
        <span class="req">*</span>
      </label>

      <input class="form-control campo-medicamento" type="date" data-name="fechaInicio" required>
    </div>

    <div class="form-group col-6 campo-destacado">
      <label>
        Duración
        <span class="req">*</span>
      </label>
      <input class="form-control campo-medicamento" type="number" data-name="duracion" min="1" step="1" required>
    </div>

    <div class="form-group col-6 campo-destacado">
      <label>
        Unidad de duración
        <span class="req">*</span>
      </label>
      <select class="form-control campo-medicamento" data-name="unidadDuracion" required>
        <option value="">
          Seleccione
        </option>

        <option value="Días">
          Días
        </option>

        <option value="Horas">
          Horas
        </option>
      </select>
    </div>

    <div class="form-group col-6 campo-fecha-final">
      <label>
        Fecha final estimada
      </label>

      <input class="form-control" type="date" data-name="fechaFin" readonly>
      <small class="fecha-ayuda">
        Se calcula automáticamente
        según inicio y duración.
      </small>
    </div>

    <div class="form-group col-12">
      <label>
        Observaciones / Justificación
      </label>
      <textarea class="form-control" data-name="observaciones" rows="3" maxlength="1000"></textarea>
    </div>
  </div>
</div>